# =============================================================================
# AI Decision Traceability Engine - Environment Configuration
# =============================================================================
# Copy this file to .env and configure according to your LLM provider choice.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENV=local
# Options: local, prod
# - local: Development environment (allows missing keys with warnings)
# - prod: Production environment (strict validation, fails fast on misconfiguration)

# -----------------------------------------------------------------------------
# LLM Provider Selection
# -----------------------------------------------------------------------------
# IMPORTANT: Choose ONE provider and configure accordingly.
# The provider determines which fields are required and which are ignored.

LLM_PROVIDER=ollama
# Options: openai, ollama, lmstudio
# - openai: Use OpenAI API (requires OPENAI_API_KEY)
# - ollama: Use local Ollama server (OPENAI_API_KEY not required)
# - lmstudio: Use local LM Studio server (OPENAI_API_KEY not required)

# -----------------------------------------------------------------------------
# Configuration for Local Providers (Ollama/LM Studio)
# -----------------------------------------------------------------------------
# These fields are used when LLM_PROVIDER is "ollama" or "lmstudio"

LLM_MODEL=qwen2.5-coder:7b-instruct
# Model name/identifier for local providers
# Examples:
#   - For Ollama: llama3.2, qwen2.5-coder:7b-instruct, mistral:7b
#   - For LM Studio: model name as configured in LM Studio

LLM_BASE_URL=http://localhost:11434/v1
# Base URL for local LLM server (must include /v1 endpoint)
# - Ollama default: http://localhost:11434/v1
# - LM Studio default: http://localhost:1234/v1
# Leave empty to use provider defaults (Ollama: 11434, LM Studio: 1234)

# -----------------------------------------------------------------------------
# Configuration for OpenAI Provider
# -----------------------------------------------------------------------------
# These fields are used ONLY when LLM_PROVIDER is "openai"
# If using local providers (ollama/lmstudio), these are ignored.

OPENAI_API_KEY=
# Required when LLM_PROVIDER=openai
# Leave empty when using local providers (ollama/lmstudio)
# Example: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

OPENAI_MODEL=gpt-4o-mini
# Model name for OpenAI API
# Examples: gpt-4o-mini, gpt-4o, gpt-4-turbo

OPENAI_BASE_URL=https://api.openai.com/v1
# Base URL for OpenAI API (usually https://api.openai.com/v1)
# Leave empty to use default OpenAI endpoint

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
MAX_REQUEST_SIZE=1048576
# Maximum request body size in bytes (default: 1MB)

LOG_LEVEL=INFO
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# How to Choose Your Provider
# =============================================================================
#
# 1. If using Ollama:
#    - Set LLM_PROVIDER=ollama
#    - Set LLM_MODEL to your Ollama model name (e.g., llama3.2)
#    - Set LLM_BASE_URL=http://localhost:11434/v1 (or leave empty for default)
#    - Leave OPENAI_API_KEY empty (not required)
#
# 2. If using LM Studio:
#    - Set LLM_PROVIDER=lmstudio
#    - Set LLM_MODEL to your LM Studio model name
#    - Set LLM_BASE_URL=http://localhost:1234/v1 (or leave empty for default)
#    - Leave OPENAI_API_KEY empty (not required)
#
# 3. If using OpenAI API:
#    - Set LLM_PROVIDER=openai
#    - Set OPENAI_API_KEY to your OpenAI API key (required)
#    - Set OPENAI_MODEL to your desired model (e.g., gpt-4o-mini)
#    - Set OPENAI_BASE_URL=https://api.openai.com/v1 (or leave empty for default)
#    - LLM_MODEL and LLM_BASE_URL are ignored when provider=openai
#
# =============================================================================
