# AI Decision Traceability Engine - Environment Configuration

# Environment: local or prod
ENV=local

# Provider: openai, ollama, or lmstudio
LLM_PROVIDER=ollama

# Local provider settings for ollama/lmstudio
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434/v1

# OpenAI provider settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Policy file used by the policy agent
POLICY_PATH=config/reference_policy.md

# Application settings
MAX_REQUEST_SIZE=1048576
LOG_LEVEL=INFO

# Examples:
#
# Ollama:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3.2
#   LLM_BASE_URL=http://localhost:11434/v1
#
# LM Studio:
#   LLM_PROVIDER=lmstudio
#   LLM_MODEL=<local-model-name>
#   LLM_BASE_URL=http://localhost:1234/v1
#
# OpenAI:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<OPENAI_API_KEY>
#   OPENAI_MODEL=gpt-4o-mini
#   OPENAI_BASE_URL=
